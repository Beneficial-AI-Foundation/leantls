/-- 2026-11-19T00:00:00Z -/
def now : Int := 1795046400

theorem example_com_valid : (validate roots chain "example.com" now).isOk = true := by native_decide
theorem example_com_wildcard_valid : (validate roots chain "WWW.Example.COM." now).isOk = true := by native_decide
theorem example_com_wrong_host : (validate roots chain "example.org" now).isOk = false := by native_decide
theorem example_com_two_labels : (validate roots chain "a.b.example.com" now).isOk = false := by native_decide
theorem example_com_after_expiry : (validate roots chain "example.com" (now + 400 * 86400)).isOk = false := by native_decide
theorem example_com_no_roots : (validate [] chain "example.com" now).isOk = false := by native_decide

/-- Flip one bit in the last byte of the leaf (inside its signature). -/
def tamperedLeaf : ByteArray := chain0.set! (chain0.size - 1) (chain0.get! (chain0.size - 1) ^^^ 1)

theorem example_com_tampered_signature :
    (validate roots (tamperedLeaf :: chain.drop 1) "example.com" now).isOk = false := by native_decide

/-! ## RFC 8448: the server's RSA certificate and its CertificateVerify -/

open LeanTLS.Spec.RFC8448 in
def rfc8448Leaf : Option Cert :=
  ((TLS13.Parser.run TLS13.parseCertificate (body certificate)).toOption.bind List.head?).bind
    (fun d => (parse d).toOption)

open LeanTLS.Spec.RFC8448 in
/-- The trace's CertificateVerify is a valid RSA-PSS-SHA256 signature by the certificate's key
    over the transcript through Certificate. -/
theorem rfc8448_certificate_verify :
    (match rfc8448Leaf, (TLS13.Parser.run TLS13.parseCertVerify (body certVerify)).toOption with
     | some c, some (scheme, sig) =>
       scheme == 0x0804 &&
       verifyCertificateVerify c.key scheme sig
         (SHA256.hash (clientHello ++ serverHello ++ encExts ++ certificate))
     | _, _ => false) = true := by
  native_decide

open LeanTLS.Spec.RFC8448 in
theorem rfc8448_certificate_verify_wrong_transcript :
    (match rfc8448Leaf, (TLS13.Parser.run TLS13.parseCertVerify (body certVerify)).toOption with
     | some c, some (scheme, sig) =>
       verifyCertificateVerify c.key scheme sig (SHA256.hash (clientHello ++ serverHello))
     | _, _ => true) = false := by
  native_decide

/-! ## hostname matching (RFC 6125) -/

theorem host_exact : hostMatches "example.com" "EXAMPLE.com" = true := by native_decide
theorem host_trailing_dot : hostMatches "example.com" "example.com." = true := by native_decide
theorem host_wildcard : hostMatches "*.example.com" "www.example.com" = true := by native_decide
theorem host_wildcard_not_bare : hostMatches "*.example.com" "example.com" = false := by native_decide
theorem host_wildcard_one_label : hostMatches "*.example.com" "a.b.example.com" = false := by native_decide
theorem host_no_partial_wildcard : hostMatches "w*.example.com" "www.example.com" = false := by native_decide
theorem host_no_tld_wildcard : hostMatches "*.com" "example.com" = false := by native_decide
theorem host_no_inner_wildcard : hostMatches "www.*.com" "www.example.com" = false := by native_decide
theorem host_empty_label : hostMatches "*.example.com" ".example.com" = false := by native_decide

/-! ## dates -/

theorem days_epoch : ASN1.daysFromCivil 1970 1 1 = 0 := by decide +kernel
theorem days_2000 : ASN1.daysFromCivil 2000 3 1 = 11017 := by decide +kernel
theorem days_leap : ASN1.daysFromCivil 2024 3 1 - ASN1.daysFromCivil 2024 2 28 = 2 := by decide +kernel

/-! ## P-256 key agreement (HelloRetryRequest path) -/

def kp1 := EC.p256Keygen (ofHex "0102030405060708091011121314151617181920212223242526272829303132")
def kp2 := EC.p256Keygen (ofHex "a1a2a3a4a5a6a7a8a9b0b1b2b3b4b5b6b7b8b9c0c1c2c3c4c5c6c7c8c9d0d1d2")

theorem p256_ecdh_agree :
    (EC.p256Shared kp1.1 kp2.2).isSome = true ∧
    EC.p256Shared kp1.1 kp2.2 = EC.p256Shared kp2.1 kp1.2 := by
  native_decide

theorem p256_rejects_off_curve :
    EC.p256Shared 7 (EC.P256.encodePoint 1 1) = none := by native_decide

end LeanTLS.Spec.X509Specs
